#!/usr/bin/env python3
"""What a run cost, per agent, priced by token type at API list prices.

Usage: engage-run-cost [--session <id>] [--since <ISO time>] [--until <ISO time>] [--out <file>]

Reads the session's main transcript and every subagent transcript under it
(~/.claude/projects/*/<session>.jsonl and <session>/subagents/**/*.jsonl). The session
defaults to $CLAUDE_CODE_SESSION_ID. --since/--until keep only the API calls in that window,
for a session that also held other work. Prints a Markdown report; --out also writes it.

Counting rules:
- One API call is one message id. Claude Code writes each content block of a response as its own
  line with the same id and usage, so a call is counted once, from its line with the largest
  output_tokens.
- Each call is priced by token type: plain input, cache write 5m (1.25x input), cache write 1h
  (2x input), cache read, output. A cache write without its 5m/1h split is priced as 5m and
  counted under "write without split".
- Fast mode (usage.speed == "fast") doubles the call's rates. Haiku 5.5 takes its higher tier
  when the call's prompt (input + cache read + cache write) is over 100K tokens.
- Synthetic messages and API errors carry no usage and are skipped. A model with no price is
  listed under "Unpriced" and left out of the totals, never guessed.
"""
import argparse, glob, json, os, sys
from collections import defaultdict
from datetime import datetime

# $ per million tokens: input, output, cache read. Cache writes derive from input.
# Source: https://platform.claude.com/docs/en/about-claude/pricing (read 2026-10-30).
PRICES = {
    "claude-fable-5-1": (10.00, 50.00, 0.25),
    "claude-mythos-5-1": (10.00, 50.00, 0.25),
    "claude-fable-5": (10.00, 50.00, 1.00),
    "claude-mythos-5": (10.00, 50.00, 1.00),
    "claude-opus-5-5": (4.00, 20.00, 0.20),
    "claude-opus-5": (5.00, 25.00, 0.50),
    "claude-opus-4-8": (5.00, 25.00, 0.50),
    "claude-opus-4-7": (5.00, 25.00, 0.50),
    "claude-opus-4-6": (5.00, 25.00, 0.50),
    "claude-opus-4-5": (5.00, 25.00, 0.50),
    "claude-opus-4-1": (15.00, 75.00, 1.50),
    "claude-opus-4": (15.00, 75.00, 1.50),
    "claude-sonnet-5-5": (2.00, 10.00, 0.10),
    "claude-sonnet-5": (2.00, 10.00, 0.20),
    "claude-sonnet-4-6": (3.00, 15.00, 0.30),
    "claude-sonnet-4-5": (3.00, 15.00, 0.30),
    "claude-sonnet-4": (3.00, 15.00, 0.30),
    "claude-haiku-5-5": (0.10, 0.50, 0.01),
    "claude-haiku-4-5": (1.00, 5.00, 0.10),
    "claude-3-5-haiku": (0.80, 4.00, 0.08),
}
HAIKU_55_LONG = (0.50, 2.50, 0.05)  # prompt over 100K tokens
WRITE_5M, WRITE_1H = 1.25, 2.0
PRICE_SOURCE = "Anthropic API list prices, platform.claude.com/docs/en/about-claude/pricing, read 2026-10-30"


def price_key(model):
    """claude-opus-5-5-20260101 or us.anthropic.claude-opus-5-5 -> claude-opus-5-5."""
    m = model.split(".")[-1]
    for k in sorted(PRICES, key=len, reverse=True):
        if m == k or m.startswith(k + "-") or m.startswith(k + "@") or m.startswith(k + "["):
            return k
    return None


def parse_time(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None


def calls_in(path, since, until):
    """One record per API message id, from the line with the largest output_tokens."""
    best = {}
    with open(path, errors="replace") as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get("type") != "assistant" or d.get("isApiErrorMessage"):
                continue
            m = d.get("message") or {}
            u = m.get("usage")
            mid = m.get("id")
            model = m.get("model") or ""
            if not u or not mid or model == "<synthetic>":
                continue
            t = parse_time(d.get("timestamp"))
            if (since and t and t < since) or (until and t and t > until):
                continue
            prev = best.get(mid)
            if prev is None or (u.get("output_tokens") or 0) > (prev["usage"].get("output_tokens") or 0):
                best[mid] = {"usage": u, "model": model, "time": t}
    return sorted(best.values(), key=lambda c: c["time"] or datetime.min)


def cost_of(call):
    u, key = call["usage"], price_key(call["model"])
    inp = u.get("input_tokens") or 0
    read = u.get("cache_read_input_tokens") or 0
    write = u.get("cache_creation_input_tokens") or 0
    out = u.get("output_tokens") or 0
    split = u.get("cache_creation") or {}
    w5, w1 = split.get("ephemeral_5m_input_tokens"), split.get("ephemeral_1h_input_tokens")
    nosplit = 0
    if w5 is None and w1 is None:
        w5, w1, nosplit = write, 0, write
    else:
        w5, w1 = w5 or 0, w1 or 0
        if w5 + w1 < write:  # part of the write came without a split
            nosplit = write - w5 - w1
            w5 += nosplit
    tokens = {"input": inp, "write5m": w5, "write1h": w1, "read": read, "output": out, "nosplit": nosplit}
    if key is None:
        return tokens, None
    pin, pout, pread = PRICES[key]
    if key == "claude-haiku-5-5" and inp + read + write > 100_000:
        pin, pout, pread = HAIKU_55_LONG
    fast = 2.0 if u.get("speed") == "fast" else 1.0
    dollars = fast * (inp * pin + w5 * pin * WRITE_5M + w1 * pin * WRITE_1H + read * pread + out * pout) / 1e6
    return tokens, dollars


def agent_label(path, main):
    if path == main:
        return "main", ""
    meta = path[: -len(".jsonl")] + ".meta.json"
    try:
        m = json.load(open(meta))
        return m.get("agentType") or "agent", (m.get("description") or "").strip()
    except (OSError, ValueError):
        return "agent", os.path.basename(path)


def find_main(session):
    hits = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session}.jsonl"))
    if not hits:
        hits = glob.glob(os.path.expanduser(f"~/.claude/projects/*/{session}*.jsonl"))
    if len(hits) != 1:
        sys.exit(f"engage-run-cost: {len(hits)} transcripts match session {session!r}; pass the full id")
    return hits[0]


def fmt_m(n):
    return f"{n / 1e6:.2f}M" if n >= 10_000 else f"{n / 1e3:.1f}K"


def main():
    ap = argparse.ArgumentParser(description="What a run cost, per agent, priced by token type.")
    ap.add_argument("--session", default=os.environ.get("CLAUDE_CODE_SESSION_ID"))
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--out")
    a = ap.parse_args()
    if not a.session:
        sys.exit("engage-run-cost: no --session and no $CLAUDE_CODE_SESSION_ID")
    since, until = parse_time(a.since), parse_time(a.until)
    main_path = find_main(a.session)
    paths = [main_path] + sorted(glob.glob(main_path[: -len(".jsonl")] + "/subagents/**/*.jsonl", recursive=True))

    agents, unpriced = [], defaultdict(int)
    by_model = defaultdict(lambda: defaultdict(float))
    first_t = last_t = None
    for p in paths:
        calls = calls_in(p, since, until)
        if not calls:
            continue
        kind, desc = agent_label(p, main_path)
        tot = defaultdict(float)
        models = set()
        ctx = []
        for c in calls:
            tokens, dollars = cost_of(c)
            key = price_key(c["model"]) or c["model"]
            models.add(key)
            ctx.append(tokens["input"] + tokens["read"] + tokens["write5m"] + tokens["write1h"])
            if dollars is None:
                unpriced[c["model"]] += 1
                continue
            for k, v in tokens.items():
                tot[k] += v
                by_model[key][k] += v
            tot["usd"] += dollars
            by_model[key]["usd"] += dollars
            by_model[key]["calls"] += 1
            t = c["time"]
            if t:
                first_t = min(first_t, t) if first_t else t
                last_t = max(last_t, t) if last_t else t
        agents.append({"kind": kind, "desc": desc, "path": p, "models": ", ".join(sorted(models)), "calls": len(calls),
                       "ctx_start": ctx[0], "ctx_peak": max(ctx), "ctx_end": ctx[-1], **tot})

    total = sum(x.get("usd", 0) for x in agents)
    lines = [f"# Run cost: session {os.path.basename(main_path)[:-6]}", ""]
    if first_t:
        lines.append(f"Window: {first_t:%Y-%m-%d %H:%M} to {last_t:%H:%M} UTC. "
                     f"API-equivalent cost: **${total:.2f}** ({PRICE_SOURCE}). "
                     "On a subscription nothing is billed per token; read the figure as a proxy for how much "
                     "of the usage limits the run took, to compare runs.")
    lines += ["", "## By model", "",
              "| Model | Calls | Input | Cache write 5m | Cache write 1h | Cache read | Output | Cost |",
              "|---|---|---|---|---|---|---|---|"]
    for k, v in sorted(by_model.items(), key=lambda x: -x[1]["usd"]):
        lines.append(f"| {k} | {int(v['calls'])} | {fmt_m(v['input'])} | {fmt_m(v['write5m'])} | "
                     f"{fmt_m(v['write1h'])} | {fmt_m(v['read'])} | {fmt_m(v['output'])} | ${v['usd']:.2f} |")
    lines += ["", "## By agent", "",
              "| Agent | What | Model | Calls | Context start → peak | Cache read | Cache write | Output | Cost | Share |",
              "|---|---|---|---|---|---|---|---|---|---|"]
    for x in sorted(agents, key=lambda x: -x.get("usd", 0)):
        share = 100 * x.get("usd", 0) / total if total else 0
        lines.append(f"| {x['kind']} | {x['desc'][:60]} | {x['models']} | {x['calls']} | "
                     f"{fmt_m(x['ctx_start'])} → {fmt_m(x['ctx_peak'])} | {fmt_m(x.get('read', 0))} | "
                     f"{fmt_m(x.get('write5m', 0) + x.get('write1h', 0))} | {fmt_m(x.get('output', 0))} | "
                     f"${x.get('usd', 0):.2f} | {share:.0f}% |")
    lines += ["", "## Transcripts", "", "In the order of the table above:", ""]
    lines += [f"- {x['kind']}: `{x['path']}`" for x in sorted(agents, key=lambda x: -x.get("usd", 0))]
    nosplit = sum(v["nosplit"] for v in by_model.values())
    if nosplit:
        lines += ["", f"Write without split: {fmt_m(nosplit)} cache-write tokens had no 5m/1h breakdown "
                  "and were priced as 5m."]
    if unpriced:
        lines += ["", "## Unpriced", ""] + [f"- {m}: {n} calls (no rate in the table, left out of the total)"
                                            for m, n in unpriced.items()]
    report = "\n".join(lines) + "\n"
    if a.out:
        os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
        with open(a.out, "w") as f:
            f.write(report)
    sys.stdout.write(report)


if __name__ == "__main__":
    main()
