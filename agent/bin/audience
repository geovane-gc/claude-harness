#!/usr/bin/env python3
import json
import os
import sys
from datetime import date

FILE = os.path.expanduser("~/{{HOME_DIR_NAME}}/knowledge/audience.json")
USAGE = """usage: audience <command>
  get <slack_user_id>                                  print the override (technical|plain) or "none"
  set <slack_user_id> <technical|plain> "<name>" "<why, in {{OWNER_FIRST_NAME}}'s words>"   only on {{OWNER_FIRST_NAME}}'s word
  list
Without an override, classify by the Slack profile Title (see knowledge/audience.md)."""


def load():
    try:
        with open(FILE) as handle:
            return json.load(handle)
    except FileNotFoundError:
        return {}


def main():
    if len(sys.argv) < 2:
        sys.exit(USAGE)
    data = load()
    command = sys.argv[1]
    if command == "get" and len(sys.argv) == 3:
        entry = data.get(sys.argv[2])
        print(entry["audience"] if entry else "none")
    elif command == "set" and len(sys.argv) == 6 and sys.argv[3] in ("technical", "plain"):
        data[sys.argv[2]] = {"name": sys.argv[4], "audience": sys.argv[3], "why": sys.argv[5], "since": str(date.today())}
        with open(FILE + ".tmp", "w") as handle:
            json.dump(data, handle, indent=1, ensure_ascii=False, sort_keys=True)
        os.replace(FILE + ".tmp", FILE)
        print(f"{sys.argv[4]} ({sys.argv[2]}) -> {sys.argv[3]}")
    elif command == "list":
        for user, entry in sorted(data.items(), key=lambda item: item[1]["name"]):
            print(f"{entry['audience']:9} {entry['name']} ({user}) — {entry['why']} [{entry['since']}]")
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
