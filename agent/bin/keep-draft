#!/usr/bin/env python3
import json
import os
import sys

FILE = os.path.expanduser("~/{{HOME_DIR_NAME}}/pepper/keep_draft.json")
USAGE = "usage: keep-draft <add|remove|list> [org/repo#number]   PRs the minder must never take out of draft ({{OWNER_FIRST_NAME}}'s word)"


def main():
    data = set(json.load(open(FILE))) if os.path.exists(FILE) else set()
    if len(sys.argv) == 2 and sys.argv[1] == "list":
        print("\n".join(sorted(data)) or "(none)")
        return
    if len(sys.argv) != 3 or sys.argv[1] not in ("add", "remove") or "#" not in sys.argv[2]:
        sys.exit(USAGE)
    (data.add if sys.argv[1] == "add" else data.discard)(sys.argv[2])
    with open(FILE + ".tmp", "w") as handle:
        json.dump(sorted(data), handle, indent=1)
    os.replace(FILE + ".tmp", FILE)
    print(f"keep-draft {sys.argv[1]} {sys.argv[2]}")


if __name__ == "__main__":
    main()
