#!/usr/bin/env python3
import re
import subprocess
import sys
import time
from datetime import datetime

SERVICE_PREFIX = "claude-agent/"
ACCOUNT = "agent"
USAGE = """usage: secret <command>
  get <name>                     print the value (for scripts: VAR=$(secret get x)); fails if expired
  set <name> [--expires ISO|+Nh]  read the value from stdin and store it
  has <name>                     exit 0 if present and not expired
  delete <name>
  list                           names with expiry, never values"""


def security(*args, stdin=None):
    return subprocess.run(["/usr/bin/security", *args], capture_output=True, text=True, input=stdin)


def expiry_of(name):
    done = security("find-generic-password", "-s", SERVICE_PREFIX + name, "-a", ACCOUNT, "-g")
    if done.returncode != 0:
        return None, False
    match = re.search(r'"icmt"<blob>="expires=(\d+)"', done.stdout)
    return (int(match.group(1)) if match else 0), True


def get(name):
    expires, found = expiry_of(name)
    if not found:
        sys.exit(f"secret {name}: not found")
    if expires and expires < time.time():
        sys.exit(f"secret {name}: expired at {datetime.fromtimestamp(expires):%Y-%m-%d %H:%M}")
    done = security("find-generic-password", "-s", SERVICE_PREFIX + name, "-a", ACCOUNT, "-w")
    sys.stdout.write(done.stdout.rstrip("\n"))


def quoted(arg):
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"') + '"'


def parse_expiry(text):
    if text.startswith("+") and text.endswith("h"):
        return int(time.time() + float(text[1:-1]) * 3600)
    return int(datetime.fromisoformat(text).timestamp())


def put(name, expires=0):
    value = sys.stdin.read().rstrip("\n")
    if not value:
        sys.exit("secret set: empty value on stdin")
    if "\n" in value or "\r" in value:
        sys.exit("secret set: the value must be a single line")
    args = ["add-generic-password", "-U", "-s", SERVICE_PREFIX + name, "-a", ACCOUNT]
    if expires:
        args += ["-j", f"expires={expires}"]
    args += ["-w", value]
    line = " ".join(quoted(arg) for arg in args) + "\n"
    done = security("-i", stdin=line)
    if done.returncode != 0:
        sys.exit(f"secret set {name}: {done.stderr.strip()}")
    print(f"stored {name}" + (f" (expires {datetime.fromtimestamp(expires):%Y-%m-%d %H:%M})" if expires else ""))


def names():
    dump = security("dump-keychain").stdout
    return sorted(set(re.findall(r'"svce"<blob>="' + re.escape(SERVICE_PREFIX) + r'([^"]+)"', dump)))


def main():
    if len(sys.argv) < 2:
        sys.exit(USAGE)
    command, rest = sys.argv[1], sys.argv[2:]
    if command == "get" and len(rest) == 1:
        get(rest[0])
    elif command == "set" and rest:
        expires = parse_expiry(rest[rest.index("--expires") + 1]) if "--expires" in rest else 0
        put(rest[0], expires)
    elif command == "has" and len(rest) == 1:
        expires, found = expiry_of(rest[0])
        sys.exit(0 if found and not (expires and expires < time.time()) else 1)
    elif command == "delete" and len(rest) == 1:
        security("delete-generic-password", "-s", SERVICE_PREFIX + rest[0], "-a", ACCOUNT)
    elif command == "list":
        for name in names():
            expires, _ = expiry_of(name)
            state = "" if not expires else (" EXPIRED" if expires < time.time() else f" expires {datetime.fromtimestamp(expires):%Y-%m-%d %H:%M}")
            print(name + state)
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
