#!/bin/bash
set -euo pipefail

HOME_DIR="$HOME/{{HOME_DIR_NAME}}"
REPOS="$HOME_DIR/repos"
WORKTREES="$HOME_DIR/worktrees"
# A bare repo name belongs to the first org in github_orgs; owner/repo names any other repo.
ORG=$(/usr/bin/python3 -c 'import json,sys;print((json.load(open(sys.argv[1])).get("github_orgs") or [""])[0])' \
  "$HOME_DIR/pepper/config.json" 2>/dev/null || true)

usage() {
  cat >&2 <<USAGE
usage: repos <command>
  ensure <repo|owner/repo>      clone it (a bare name is in the first of github_orgs) into repos/ if missing, then fetch; prints its path
  sync [repo...]                fetch + fast-forward the default branch of every clone (or the ones named)
  worktree <repo> <name> [ref]  new worktree worktrees/<repo>/<name> on branch <name> from ref (default origin/<default>)
  clean <repo> <name>           remove that worktree and its local branch if merged or unpushed-free
  list                          clones and worktrees
USAGE
  exit 1
}

token() {
  printf 'protocol=https\nhost=github.com\n\n' | git credential fill 2>/dev/null | sed -n 's/^password=//p'
}

default_branch() {
  git -C "$REPOS/$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || echo main
}

ensure() {
  local full=$1 repo=${1##*/}
  local path="$REPOS/$repo"
  case "$full" in */*) ;; *) [ -n "$ORG" ] || { echo "no github_orgs in pepper/config.json" >&2; return 1; }; full="$ORG/$full" ;; esac
  if [ ! -d "$path/.git" ]; then
    git clone -q "https://github.com/$full.git" "$path" >&2
  fi
  git -C "$path" fetch -q --prune origin >&2
  echo "$path"
}

sync_one() {
  local repo=$1 path="$REPOS/$1" branch
  git -C "$path" fetch -q --prune origin || { echo "fetch failed: $repo" >&2; return 0; }
  branch=$(default_branch "$repo")
  if [ "$(git -C "$path" branch --show-current)" = "$branch" ] && git -C "$path" diff --quiet; then
    git -C "$path" merge -q --ff-only "origin/$branch" 2>/dev/null || echo "not fast-forward: $repo" >&2
  fi
}

case "${1:-}" in
  ensure) [ $# -eq 2 ] || usage; ensure "$2" ;;
  sync)
    shift
    if [ $# -eq 0 ]; then set -- $(ls "$REPOS"); fi
    for repo in "$@"; do sync_one "$repo" & done
    wait ;;
  worktree)
    [ $# -ge 3 ] || usage
    repo=${2##*/}; name=$3; ensure "$2" >/dev/null
    ref=${4:-origin/$(default_branch "$repo")}
    mkdir -p "$WORKTREES/$repo"
    git -C "$REPOS/$repo" worktree add -q -b "$name" "$WORKTREES/$repo/$name" "$ref" >&2
    echo "$WORKTREES/$repo/$name" ;;
  clean)
    [ $# -eq 3 ] || usage
    git -C "$REPOS/$2" worktree remove "$WORKTREES/$2/$3"
    git -C "$REPOS/$2" branch -d "$3" 2>/dev/null || echo "branch $3 kept (not merged)" >&2
    git -C "$REPOS/$2" worktree prune ;;
  list)
    ls "$REPOS"; echo "--"; find "$WORKTREES" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | sed "s#$WORKTREES/##" ;;
  *) usage ;;
esac
