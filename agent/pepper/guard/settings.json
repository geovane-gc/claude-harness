{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/{{HOME_DIR_NAME}}/pepper/guard/slack_send_guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Linear__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/{{HOME_DIR_NAME}}/pepper/guard/linear_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/{{HOME_DIR_NAME}}/pepper/guard/bash_guard.py"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 ~/{{HOME_DIR_NAME}}/pepper/guard/read_guard.py"
          }
        ]
      }
    ]
  }
}
